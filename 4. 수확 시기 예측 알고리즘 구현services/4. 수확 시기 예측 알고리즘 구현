4-1. 수확 예측 함수 추가
growthService.js의 아래쪽에 다음 코드 추가

// 수확 시기 예측
async function predictHarvest(plantId) {

    // 최근 생육 기록 조회
    const records = await getGrowthRecords(plantId, 30);

    if (records.length === 0) {
        throw new Error('생육 기록이 없습니다.');
    }

    // 최근 AI 분석 결과 조회
    const [analysisRows] = await db.execute(
        `SELECT
            a.fruit_maturity,
            a.confidence,
            a.analyzed_at
         FROM ai_analysis a
         JOIN plant_images i
            ON a.image_id = i.image_id
         WHERE i.plant_id = ?
         ORDER BY a.analyzed_at DESC
         LIMIT 1`,
        [plantId]
    );

    if (analysisRows.length === 0) {
        throw new Error('AI 분석 결과가 없습니다.');
    }

    const analysis = analysisRows[0];

    // 숙도별 예상 기간
    const harvestDays = {
        GREEN: 18,
        TURNING: 7,
        RED: 2
    };

    const maturity = analysis.fruit_maturity;

    if (!Object.prototype.hasOwnProperty.call(
        harvestDays,
        maturity
    )) {
        throw new Error(
            '현재 숙도 정보로는 수확 시기를 예측할 수 없습니다.'
        );
    }

    const daysRemaining = harvestDays[maturity];

    // 예상 수확일 계산
    const predictedDate = new Date();

    predictedDate.setDate(
        predictedDate.getDate() + daysRemaining
    );

    const formattedDate = [
        predictedDate.getFullYear(),
        String(predictedDate.getMonth() + 1).padStart(2, '0'),
        String(predictedDate.getDate()).padStart(2, '0')
    ].join('-');

    // 예측 신뢰도 계산
    // 데이터 개수와 AI 분석 신뢰도를 반영한 참고용 점수
    const aiConfidence =
        Number(analysis.confidence);

    const validConfidence =
        Number.isFinite(aiConfidence)
            ? Math.max(0, Math.min(1, aiConfidence))
            : 0;

    const dataScore = Math.min(
        records.length / 10,
        1
    );

    const confidence = Number(
        (
            validConfidence * 70 +
            dataScore * 30
        ).toFixed(2)
    );

    const predictionBasis =
        `AI 숙도 분석: ${maturity}, ` +
        `생육 기록 개수: ${records.length}, ` +
        `초기 숙도 기준 예상 기간: ${daysRemaining}일`;

    // 예측 결과 저장
    const [result] = await db.execute(
        `INSERT INTO harvest_predictions (
            plant_id,
            predicted_date,
            days_remaining,
            confidence,
            prediction_basis,
            model_version,
            created_at
        )
        VALUES (?, ?, ?, ?, ?, ?, NOW())`,
        [
            plantId,
            formattedDate,
            daysRemaining,
            confidence,
            predictionBasis,
            'rule-based-v1'
        ]
    );

    return {
        prediction_id: result.insertId,
        plant_id: plantId,
        maturity: maturity,
        predicted_date: formattedDate,
        days_remaining: daysRemaining,
        confidence: confidence,
        model_version: 'rule-based-v1',
        prediction_basis: predictionBasis
    };
}

