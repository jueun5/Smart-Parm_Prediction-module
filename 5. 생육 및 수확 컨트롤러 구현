const db = require('../config/db');
const growthService = require('../services/growthService');


// 생육 기록 등록
exports.createGrowthRecord = async (req, res) => {
    try {
        const plantId = Number(req.params.plant_id);

        if (!Number.isInteger(plantId) || plantId <= 0) {
            return res.status(400).json({
                success: false,
                message: '올바르지 않은 식물 ID입니다.'
            });
        }

        const {
            growth_stage,
            plant_height_cm,
            fruit_count,
            average_fruit_size_mm,
            leaf_status,
            notes
        } = req.body;

        // 식물 존재 여부 확인
        const [plants] = await db.execute(
            'SELECT plant_id FROM plants WHERE plant_id = ?',
            [plantId]
        );

        if (plants.length === 0) {
            return res.status(404).json({
                success: false,
                message: '등록된 식물이 없습니다.'
            });
        }

        // 숫자값 검증
        if (
            plant_height_cm != null &&
            (!Number.isFinite(Number(plant_height_cm)) ||
                Number(plant_height_cm) < 0)
        ) {
            return res.status(400).json({
                success: false,
                message: '초장 값이 올바르지 않습니다.'
            });
        }

        if (
            fruit_count != null &&
            (!Number.isInteger(Number(fruit_count)) ||
                Number(fruit_count) < 0)
        ) {
            return res.status(400).json({
                success: false,
                message: '열매 개수가 올바르지 않습니다.'
            });
        }

        if (
            average_fruit_size_mm != null &&
            (!Number.isFinite(Number(average_fruit_size_mm)) ||
                Number(average_fruit_size_mm) < 0)
        ) {
            return res.status(400).json({
                success: false,
                message: '평균 열매 크기가 올바르지 않습니다.'
            });
        }

        const growthId = await growthService.saveGrowthRecord({
            plant_id: plantId,
            growth_stage,
            plant_height_cm,
            fruit_count,
            average_fruit_size_mm,
            leaf_status,
            notes
        });

        res.status(201).json({
            success: true,
            growth_id: growthId,
            message: '생육 기록이 저장되었습니다.'
        });

    } catch (error) {
        console.error('생육 기록 저장 오류:', error);

        res.status(500).json({
            success: false,
            message: '생육 기록 저장에 실패했습니다.'
        });
    }
};


