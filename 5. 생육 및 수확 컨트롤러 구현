            growth_id: growthId,
            message: 'AI 분석 결과가 생육 기록으로 저장되었습니다.'
        });

    } catch (error) {
        console.error('AI 생육 기록 저장 오류:', error);

        res.status(500).json({
            success: false,
            message: error.message
        });
