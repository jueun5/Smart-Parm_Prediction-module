            !Number.isInteger(plantId) ||
            plantId <= 0 ||
            !Number.isInteger(imageId) ||
            imageId <= 0
        ) {
            return res.status(400).json({
                success: false,
                message: '식물 ID 또는 이미지 ID가 올바르지 않습니다.'
            });
