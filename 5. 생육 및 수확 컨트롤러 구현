// 실제 수확 기록 등록
exports.createHarvestRecord = async (req, res) => {
    try {
        const plantId = Number(req.params.plant_id);

        const {
            harvested_at,
            fruit_count,
            harvest_weight_g,
            grade,
            notes
        } = req.body;

        if (!Number.isInteger(plantId) || plantId <= 0) {
            return res.status(400).json({
                success: false,
                message: '올바르지 않은 식물 ID입니다.'
            });
        }

        if (
            fruit_count != null &&
            (!Number.isInteger(Number(fruit_count)) ||
                Number(fruit_count) < 0)
        ) {
            return res.status(400).json({
                success: false,
                message: '수확 개수가 올바르지 않습니다.'
            });
        }

        if (
            harvest_weight_g != null &&
            (!Number.isFinite(Number(harvest_weight_g)) ||
                Number(harvest_weight_g) < 0)
        ) {
            return res.status(400).json({
                success: false,
                message: '수확 무게가 올바르지 않습니다.'
            });
        }

        const [result] = await db.execute(
            `INSERT INTO harvest_records (
                plant_id,
                harvested_at,
                fruit_count,
                harvest_weight_g,
                grade,
                notes
            )
            VALUES (?, ?, ?, ?, ?, ?)`,
            [
                plantId,
                harvested_at || new Date(),
                fruit_count ?? null,
                harvest_weight_g ?? null,
                grade || null,
                notes || null
            ]
        );

        res.status(201).json({
            success: true,
            harvest_id: result.insertId,
            message: '실제 수확 기록이 저장되었습니다.'
        });

    } catch (error) {
        console.error('수확 기록 저장 오류:', error);

        res.status(500).json({
            success: false,
            message: '수확 기록 저장에 실패했습니다.'
        });
    }
};


// 실제 수확 기록 조회
exports.getHarvestRecords = async (req, res) => {
    try {
        const plantId = Number(req.params.plant_id);

        const [rows] = await db.execute(
            `SELECT *
             FROM harvest_records
             WHERE plant_id = ?
             ORDER BY harvested_at DESC
             LIMIT 100`,
            [plantId]
        );

        res.json({
            success: true,
            count: rows.length,
            records: rows
        });

    } catch (error) {
        console.error('수확 기록 조회 오류:', error);

        res.status(500).json({
            success: false,
            message: '수확 기록 조회에 실패했습니다.'
        });
    }
};
